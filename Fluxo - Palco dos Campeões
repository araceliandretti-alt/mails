def rounded(x, y, w, h, face, edge=LINE, radius=0.18, lw=1.2):
    patch = FancyBboxPatch((x, y), w, h,
                           boxstyle=f'round,pad=0.015,rounding_size={radius}',
                           facecolor=face, edgecolor=edge, linewidth=lw)
    ax.add_patch(patch)
    return patch


def txt(x, y, s, size=10, color=INK, weight='normal', ha='left', va='top', linesp=1.15, z=5):
    ax.text(x, y, s, fontsize=size, color=color, fontweight=weight, ha=ha, va=va,
            linespacing=linesp, zorder=z)


def wrap(s, width):
    return textwrap.fill(s, width=width, break_long_words=False)


def card(x, y, w, h, title, body, accent, fill=WHITE, title_size=10.5, body_size=8.4):
    rounded(x, y, w, h, fill, edge=LINE)
    ax.add_patch(FancyBboxPatch((x, y), 0.07, h, boxstyle='square,pad=0',
                                facecolor=accent, edgecolor=accent, linewidth=0))
    txt(x+0.22, y+h-0.18, title, size=title_size, color=NAVY, weight='bold')
    txt(x+0.22, y+h-0.50, wrap(body, max(20, int(w*9))), size=body_size, color=INK, va='top')

